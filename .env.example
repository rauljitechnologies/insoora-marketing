# ── The marketing site's own public origin ───────────────────────────────
# Canonical URLs, Open Graph URLs, the sitemap and robots.txt are built from
# this. Until it is set to a real (non-localhost) domain, every page is
# noindex and the sitemap is empty — deliberately, so a Vercel preview URL
# cannot get indexed alongside the real site.
NEXT_PUBLIC_SITE_URL=https://insoora.com

# ── Where the product lives ──────────────────────────────────────────────
# Every "Sign in" and "Get Started" control points into this origin, and
# /api/enquiries relays the contact form to it server-side. Required: unset,
# the whole conversion path 404s against this host.
NEXT_PUBLIC_APP_URL=https://app.insoora.com
